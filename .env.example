# Environment Variables Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# LLM Chatbot Key (Optional - Fallback template engine works without key)
GEMINI_API_KEY=

# Twilio Credentials for SMS and IVR (Optional - Simulation fallback provided)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VOICE_STATE_SECRET=
VOICE_BASE_URL=
TTS_PROVIDER=
TTS_API_URL=
TTS_API_KEY=
VOICE_AUDIO_PUBLIC_URL=
PHONE_API_KEY=
TTS_VOICE_EN=en-IN
TTS_VOICE_TA=ta-IN

# Cache Database
DATABASE_URL=sqlite:///./cache.db

# CORS Allowed Origins
# Keep this list explicit because the API enables credentials.
CORS_ORIGINS=https://mazh-ai.vercel.app,http://localhost:5173,http://localhost:3000

# Weather provider
# The backend uses Open-Meteo and does not require an API key.

# Rainfall-risk ML
ML_ENABLED=true
RAIN_THRESHOLD_MM=10
