# Environment Variables Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# LLM Chatbot Key (Optional - Fallback template engine works without key)
GEMINI_API_KEY=

# Twilio Credentials for SMS and IVR (Optional - Simulation fallback provided)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cache Database
DATABASE_URL=sqlite:///./cache.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*
